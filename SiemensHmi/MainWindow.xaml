<Window x:Class="SiemensHmi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="Siemens S7 HMI"
        Height="720" Width="1200"
        MinHeight="640" MinWidth="1024"
        Background="#F5F5F3"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="Card"        Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Border"      Color="#E8E8E4"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#8A8A85"/>
        <SolidColorBrush x:Key="Accent"      Color="#5A6E60"/>
        <SolidColorBrush x:Key="Good"        Color="#5A6E60"/>
        <SolidColorBrush x:Key="Alert"       Color="#B5654A"/>
        <SolidColorBrush x:Key="Divider"     Color="#F0F0EC"/>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
        </Style>

        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BigNumber" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="42"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Height"     Value="32"/>
            <Setter Property="Padding"    Value="10,0"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background"      Value="#FCFCFA"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"  Value="{StaticResource Accent}"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="Height"      Value="36"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A5E50"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#C8C8C4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="Height"      Value="36"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F0EC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboFlat" TargetType="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height"   Value="32"/>
            <Setter Property="Padding"  Value="8,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Background"  Value="#FCFCFA"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource Card}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="28,14">
            <TextBlock Text="Siemens S7 HMI  ·  电机与产线控制"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"/>
        </Border>

        <!-- 主体 -->
        <Grid Grid.Row="1" Margin="24,20,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左栏 -->
            <StackPanel Grid.Column="0" Margin="0,0,16,0">

                <!-- 连接配置 -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel Margin="20,16,20,16">
                        <TextBlock Text="连接配置" Style="{StaticResource CardHeader}" Margin="0,0,0,12"/>

                        <TextBlock Text="PLC IP 地址" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding PlcIp}" Margin="0,0,0,10"/>

                        <TextBlock Text="CPU 类型" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <ComboBox Style="{StaticResource ComboFlat}"
                                  ItemsSource="{Binding CpuList}"
                                  SelectedItem="{Binding SelectedCpu}"
                                  Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="连接"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ConnectCmd}" Margin="0,0,5,0"/>
                            <Button Grid.Column="1" Content="断开"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding DisConnectCmd}" Margin="5,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 电机状态 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Margin="20,16,20,16">
                        <TextBlock Text="电机状态" Style="{StaticResource CardHeader}" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="10" Height="10"
                                     Fill="{Binding MotorRunColor}"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="运行中" Margin="12,0,0,0" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding MotorRunning}" Margin="8,0,0,0"
                                       Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="10" Height="10"
                                     Fill="{Binding MotorFaultColor}"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="故障" Margin="12,0,0,0" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding MotorFault}" Margin="8,0,0,0"
                                       Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                        </StackPanel>

                        <Grid Margin="0,4">
                            <TextBlock Text="通信状态" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding ConnStatus}" HorizontalAlignment="Right"
                                       Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 右栏 -->
            <TabControl Grid.Column="1" Margin="16,0,0,0" Background="Transparent" BorderThickness="0">

                <!-- 标签页 1：实时监控 -->
                <TabItem Header="实时监控">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="180"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 传感器数值 -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,5,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="44"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" BorderBrush="{StaticResource Divider}"
                                            BorderThickness="0,0,0,1" Padding="22,0">
                                        <TextBlock Text="温度" Style="{StaticResource CardHeader}" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Temperature}" Style="{StaticResource BigNumber}" VerticalAlignment="Bottom"/>
                                            <TextBlock Text="°C" Margin="6,0,0,10" VerticalAlignment="Bottom"
                                                       Foreground="{StaticResource TextMuted}" FontSize="14"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="5,0,5,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="44"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" BorderBrush="{StaticResource Divider}"
                                            BorderThickness="0,0,0,1" Padding="22,0">
                                        <TextBlock Text="压力" Style="{StaticResource CardHeader}" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Pressure}" Style="{StaticResource BigNumber}" VerticalAlignment="Bottom"/>
                                            <TextBlock Text="kPa" Margin="6,0,0,10" VerticalAlignment="Bottom"
                                                       Foreground="{StaticResource TextMuted}" FontSize="14"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="5,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="44"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" BorderBrush="{StaticResource Divider}"
                                            BorderThickness="0,0,0,1" Padding="22,0">
                                        <TextBlock Text="生产数量" Style="{StaticResource CardHeader}" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding ProductionCount}" Style="{StaticResource BigNumber}" VerticalAlignment="Bottom"/>
                                            <TextBlock Text="件" Margin="6,0,0,10" VerticalAlignment="Bottom"
                                                       Foreground="{StaticResource TextMuted}" FontSize="14"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 控制按钮 -->
                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel Margin="22,16,22,20">
                                <TextBlock Text="设备控制" Style="{StaticResource CardHeader}" Margin="0,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="启动"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding StartCmd}" Margin="0,0,5,0" Height="44"/>
                                    <Button Grid.Column="1" Content="停止"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding StopCmd}" Margin="5,0,5,0" Height="44"/>
                                    <Button Grid.Column="2" Content="复位"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding ResetCmd}" Margin="5,0,0,0" Height="44"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 参数设置 -->
                        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel Margin="22,16,22,20">
                                <TextBlock Text="参数设置" Style="{StaticResource CardHeader}" Margin="0,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="目标温度 (℃)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                        <TextBox Style="{StaticResource InputBox}"
                                                 Text="{Binding TargetTemperature, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="目标压力 (kPa)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                        <TextBox Style="{StaticResource InputBox}"
                                                 Text="{Binding TargetPressure, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="下发参数"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding ApplyParamsCmd}"
                                            Width="100" VerticalAlignment="Bottom"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ⭐ 故障注入（新增） -->
                        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                            <StackPanel Margin="22,16,22,20">
                                <TextBlock Text="故障注入（仅模拟器有效）" Style="{StaticResource CardHeader}" Margin="0,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="模拟断线"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding SimDisconnectCmd}" Margin="0,0,5,0" Height="40"/>
                                    <Button Grid.Column="1" Content="模拟超时"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding SimTimeoutCmd}" Margin="5,0,5,0" Height="40"/>
                                    <Button Grid.Column="2" Content="数据跳变"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding BiasDataCmd}" Margin="5,0,0,0" Height="40"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 日志 -->
                        <Border Grid.Row="4" Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="44"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" BorderBrush="{StaticResource Divider}"
                                        BorderThickness="0,0,0,1" Padding="22,0">
                                    <Grid>
                                        <TextBlock Text="通信日志" Style="{StaticResource CardHeader}" VerticalAlignment="Center"/>
                                        <Button Content="清空" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Style="{StaticResource GhostButton}" Height="26" Padding="12,0"
                                                Command="{Binding ClearLogCmd}"/>
                                    </Grid>
                                </Border>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,12">
                                    <TextBox Text="{Binding LogText}" BorderThickness="0" Background="Transparent"
                                             FontFamily="Consolas, Microsoft YaHei UI" FontSize="12.5"
                                             Foreground="{StaticResource TextPrimary}" IsReadOnly="True" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- 标签页 2：历史数据 -->
                <TabItem Header="历史数据">
                    <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="22,0">
                                <Grid>
                                    <TextBlock Text="历史数据查询" Style="{StaticResource CardHeader}" VerticalAlignment="Center"/>
                                    <Button Content="查询最近100条" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Style="{StaticResource GhostButton}" Height="26" Padding="12,0"
                                            Command="{Binding QueryHistoryCmd}"/>
                                </Grid>
                            </Border>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding HistoryList}" AutoGenerateColumns="True"
                                      Background="Transparent" BorderThickness="0" Margin="10"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                      CanUserAddRows="False" IsReadOnly="True"
                                      AlternatingRowBackground="#F9F9F7"/>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- 标签页 3：趋势曲线 -->
                <TabItem Header="趋势曲线">
                    <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0">
                        <oxy:PlotView Model="{Binding PlotModel}" Background="Transparent"/>
                    </Border>
                </TabItem>

            </TabControl>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="{StaticResource Card}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="28,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{Binding ConnColor}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ConnStatus}" Margin="10,0,0,0" FontSize="12.5"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Siemens S7  ·  ISO-on-TCP" FontSize="12.5"
                           Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="V1.0.0" FontSize="12.5"
                           Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>